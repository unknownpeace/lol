# Enforce LF line endings across all scripts, web assets, configs, and extensionless executables
# Prevents "\r: not found" on Alpine Linux (BusyBox ash) and OpenWrt (rpcd/procd)
modules/luci/rpcd/gateway text eol=lf
*.sh text eol=lf
*.bash text eol=lf
*.py text eol=lf
*.js text eol=lf
*.css text eol=lf
*.html text eol=lf
*.svg text eol=lf
*.json text eol=lf
*.md text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.nft text eol=lf
*.conf text eol=lf
*.example text eol=lf
