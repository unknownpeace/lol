# ==============================================================================
# Конфигурация параметров Sidecar-шлюза (gateway.env)
# Расположение на сервере: /etc/sing-box/gateway.env
# ==============================================================================

# Активное ядро маршрутизации (singbox / mihomo) и веб-панель (zashboard / metacubexd)
CORE_ENGINE="singbox"
WEB_UI="zashboard"

# IP-адрес вышестоящего роутера (LAN Gateway, напр. 192.168.1.5 с DHCP)
GW_IP="192.168.1.5"

# Ссылки на удаленные подписки (через пробел)
SUB_URL="https://example.com/api/v1/client/subscribe?token=xxx"

# Логин и единый мастер-пароль администратора (AdGuard Home, Zashboard, Samba)
AGH_USER="admin"
ADMIN_PASS="admin"

# Разрешать ли ноды из РФ в автоматических селекторах (yes/no)
ALLOW_RU_NODES="no"

# Лицензионный ключ Cloudflare WARP+ / Zero Trust (опционально)
WARP_LICENSE=""

# Настройки Telegram-бота для уведомлений и бэкапов
TG_BOT_TOKEN=""
TG_CHAT_ID=""
