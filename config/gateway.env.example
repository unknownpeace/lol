# ==============================================================================
# Конфигурация параметров Sidecar-шлюза (gateway.env)
# Расположение на сервере: /etc/sing-box/gateway.env
# ==============================================================================

# IP-адрес вышестоящего роутера (LAN Gateway)
GW_IP="192.168.1.1"

# Ссылки на удаленные подписки (через пробел)
SUB_URL="https://example.com/api/v1/client/subscribe?token=xxx"

# Единый мастер-пароль администратора (Zashboard, AdGuard, Samba)
ADMIN_PASS="admin"

# Разрешать ли ноды из РФ в автоматических селекторах (yes/no)
ALLOW_RU_NODES="no"

# Включение резервного пула Cloudflare WARP (yes/no)
WARP_ENABLED="yes"

# Защита Killswitch от утечек трафика при падении прокси (yes/no)
KILLSWITCH="no"

# Настройки Telegram-бота для уведомлений и бэкапов
TG_BOT_TOKEN=""
TG_CHAT_ID=""
