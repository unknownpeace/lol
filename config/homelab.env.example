# ==============================================================================
# Конфигурация домашнего сервера (homelab.env)
# Расположение на сервере: /etc/sing-box/homelab.env
# ==============================================================================

# Пользователь и пароль для Samba (SMB3)
SMB_USER="homelab"
SMB_PASS="admin"

# Корневой каталог единого хранилища
STORAGE_ROOT="/srv/storage"

# Использовать ли единую структуру папок для Jellyfin (yes/no)
JELLYFIN_UNIFIED_MEDIA="yes"

# Настройки внешнего накопителя (LUKS2 / ext4 / btrfs)
EXT_STORAGE_EXPECTED="no"
EXT_STORAGE_UUID=""
EXT_STORAGE_LUKS_UUID=""
EXT_STORAGE_FSTYPE="ext4"
