# ==============================================================================
# 🚀 Universal Sidecar Gateway & Homelab: Файл автоматических ответов (Answers)
# ==============================================================================
# Поместите этот файл как /opt/gateway/gateway.answers или запустите установку:
#   ./setup.sh --answers gateway.answers
# После этого шлюз и все выбранные сервисы развернутся без единого вопроса!
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Сеть и подключение к интернету
# ------------------------------------------------------------------------------
# Ссылка на подписку (http/https), URI-ключ (vless://, vmess://, ss://, hy2://)
# Или 'warp' для бесплатной генерации безлимитного Cloudflare WARP 2.0 (MASQUE H2).
SUB_URL="warp"

# Лицензионный ключ Cloudflare WARP+ / Zero Trust (опционально при SUB_URL="warp")
WARP_LICENSE=""

# Локальный IP-адрес самого сервера Alpine Linux.
# Значение "auto" — скрипт сам определит текущий IP сетевого интерфейса (рекомендуется).
TARGET_LAN_IP="auto"

# IP-адрес вашего основного домашнего роутера (шлюз по умолчанию).
# Значение "auto" — скрипт сам определит IP из таблицы маршрутизации (обычно 192.168.1.1).
GW_IP="auto"

# ------------------------------------------------------------------------------
# 2. Учетные данные администратора (Единый мастер-логин)
# ------------------------------------------------------------------------------
# Логин администратора для панелей (AdGuard Home, Sing-Box, сетевого диска Samba)
ADMIN_USER="admin"

# Единый мастер-пароль. Применяется для:
# - Панель AdGuard Home (https://adguard.lan)
# - Панель Sing-Box Zashboard (https://zashboard.lan)
# - Сетевая папка Samba (\\ip\storage)
# - Мастер-пароль админ-панели Vaultwarden (/admin)
ADMIN_PASS="ChangeMe123!"

# Включить ночное автоматическое обновление ядер и баз правил в 04:00? (yes / no)
ENABLE_AUTOUPDATE="no"

# ------------------------------------------------------------------------------
# 3. Модули домашнего сервера (Homelab & Media Stack)
# ------------------------------------------------------------------------------
# Номера или имена модулей через пробел.
# Доступные модули:
#   1 или caddy       — Обратный прокси HTTPS и локальный Центр Сертификации (*.lan)
#   2 или samba       — Сетевой диск SMB3 + автообнаружение Windows 11 (24H2) и Linux
#   3 или vaultwarden — Менеджер паролей Bitwarden (https://vaultwarden.lan)
#   4 или forgejo     — Локальный Git-сервер (https://forgejo.lan)
#   5 или code        — VS Code в браузере (Server-Code) (https://code.lan)
#   6 или metube      — Веб-панель загрузки видео и музыки MeTube (https://downloads.lan)
#   7 или torrent     — Торрент-клиент Transmission (https://torrents.lan)
#
# Примеры:
#   HOMELAB_MODULES="all"               # Установить абсолютно все сервисы
#   HOMELAB_MODULES="1 2 3 6 7"         # Caddy + Samba + Vaultwarden + MeTube + Torrent
#   HOMELAB_MODULES="none"              # Только шлюз (Sing-Box + AdGuard), без Homelab
HOMELAB_MODULES="1 2 3 6 7"

# ------------------------------------------------------------------------------
# 4. Внешний накопитель и шифрование (USB / SATA / NVMe) [Опционально]
# ------------------------------------------------------------------------------
# Настройка хранилища /srv/storage.
# Варианты:
#   "none" — не настраивать внешний накопитель (использовать системный раздел)
#   "auto" — автоматически подключить первый обнаруженный внешний диск
#   "/dev/sdb" или "/dev/sdb1" — конкретный диск или раздел
STORAGE_DISK="none"

# Действие с диском:
#   "mount"  — подключить существующий диск с данными (БЕЗ форматирования)
#   "format" — отформатировать начисто (ВНИМАНИЕ: данные будут стерты!)
STORAGE_ACTION="mount"

# Файловая система (при STORAGE_ACTION="format"):
#   "ext4"  — максимальная живучесть и стандарт надежности
#   "btrfs" — CoW сжатие zstd:3 (экономия места под бэкапы и репозитории)
#   "f2fs"  — оптимизировано под флешки и SSD (Flash-Friendly FS)
STORAGE_FS="ext4"

# Шифрование диска через LUKS2 (AES-XTS 512-bit + Argon2id):
#   "yes" — использовать LUKS2 контейнер (с авто-разблокировкой ключом при загрузке)
#   "no"  — без шифрования
STORAGE_LUKS="no"

# Пароль для разблокировки или создания LUKS2 (если пусто — используется ADMIN_PASS)
STORAGE_LUKS_PASS=""

# ------------------------------------------------------------------------------
# 5. SSL / TLS Сертификат: Бесплатный Let's Encrypt Wildcard [Опционально]
# ------------------------------------------------------------------------------
# Режим сертификатов:
#   "local"   — Локальный доверенный PKI (*.lan)
#   "duckdns" — Официальный Let's Encrypt Wildcard (*.domain.duckdns.org)
SSL_TYPE="local"

# Субдомен DuckDNS (например, 'dmzzone' для dmzzone.duckdns.org)
DUCKDNS_SUBDOMAIN=""

# Токен учетной записи DuckDNS (UUID с https://www.duckdns.org)
DUCKDNS_TOKEN=""
