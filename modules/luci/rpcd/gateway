#!/bin/sh
# ==============================================================================
# RPCD JSON-RPC обертка LuCI для Universal Sidecar Gateway (OpenWrt)
# Делегирует все методы общему POSIX бэкенду modules/webui/api.sh
# ==============================================================================
export PATH="/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"

if [ "${1:-}" = "list" ]; then
    cat <<'EOF'
{
	"status": {},
	"trace": {},
	"domain_inspect": { "domain": "str" },
	"set_dhcp": { "mode": "str" },
	"set_killswitch": { "mode": "str" },
	"set_cron": { "target": "str", "enabled": "str" },
	"set_network": { "lan_ip": "str", "gw_ip": "str" },
	"set_subscription": { "urls": "str", "allow_ru": "str" },
	"node_add": { "uri": "str" },
	"node_delete": { "index": 0 },
	"domain_rule": { "action": "str", "list": "str", "domain": "str" },
	"device_rule": { "mode": "str", "ip": "str" },
	"set_telegram": { "action": "str", "token": "str", "chat_id": "str" },
	"set_password": { "password": "str" },
	"update_check": {},
	"get_logs": { "target": "str", "lines": 0 },
	"job_start": { "action": "str", "arg1": "str", "arg2": "str" },
	"job_poll": { "id": "str" }
}
EOF
    exit 0
fi

[ "${1:-}" = "call" ] || exit 1

GW_ROOT=""
if [ -n "${GATEWAY_DIR:-}" ] && [ -f "${GATEWAY_DIR}/modules/webui/api.sh" ]; then
    GW_ROOT="$GATEWAY_DIR"
elif [ -f "/opt/gateway/modules/webui/api.sh" ]; then
    GW_ROOT="/opt/gateway"
elif [ -L "/usr/bin/gw" ]; then
    _GW_BIN=$(readlink -f /usr/bin/gw 2>/dev/null || true)
    [ -n "$_GW_BIN" ] && [ -f "$(dirname "$_GW_BIN")/modules/webui/api.sh" ] && GW_ROOT=$(dirname "$_GW_BIN")
fi

if [ -z "$GW_ROOT" ]; then
    printf '{"ok":false,"error":"Не найден общий API бэкенд modules/webui/api.sh"}\n'
    exit 0
fi

exec /bin/sh "${GW_ROOT}/modules/webui/api.sh" call "${2:-}"
