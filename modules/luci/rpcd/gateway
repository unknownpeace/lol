                _json_err "Системные суффиксы +.localdomain и +.lan удалять нельзя"
                return 0
            }
            awk -v d="$CLEAN_SUF" 'NF && $0 != d {print}' "$TGT_F" > "${TGT_F}.tmp.$$" && mv -f "${TGT_F}.tmp.$$" "$TGT_F"
